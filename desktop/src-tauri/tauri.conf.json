{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lilt",
  "version": "1.0.0",
  "identifier": "com.lilt.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Lilt","width":1180,"height":780,"minWidth":920,"minHeight":640,"visible":true}],
    "security": {"csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:;"}
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/installer/setup-icon-256.png"],
    "targets": ["nsis"],
    "homepage": "",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "installerIcon": "icons/installer/setup-icon.ico",
        "uninstallerIcon": "icons/installer/setup-icon.ico",
        "installerHooks": "windows/nsis-hooks.nsh"
      },
      "wix": {
        "language": {
          "en-US": {
            "localePath": "windows/wix-en-us.wxl"
          }
        },
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    }
  }
}
